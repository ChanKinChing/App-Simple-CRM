# Backend (Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/simplecrm
SPRING_DATASOURCE_USERNAME=crm_app
SPRING_DATASOURCE_PASSWORD=change_me

# JWT - generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_value
JWT_TTL_MINUTES=60

# Seed demo data (2 users, 20 customers, 30 follow-ups) on first start
APP_SEED_DEMO=true

# CORS: comma separated list of browser origins allowed to call /api/**
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend needs no env vars: dev uses the Vite proxy, docker compose uses nginx.
# Docker compose
POSTGRES_PASSWORD=change_me
FRONTEND_PORT=8082
